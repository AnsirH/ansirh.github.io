---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SITE, INTRO, ABOUT, TIMELINE, TOOLS, CONTACT } from '../consts';
import '../styles/home.css';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;
const games = (await getCollection('games')).sort(byOrder);
const work = (await getCollection('work')).sort(byOrder);

const ORDINAL = ['첫', '두', '세', '네', '다섯', '여섯', '일곱', '여덟', '아홉'];
const COUNT = ['한', '두', '세', '네', '다섯', '여섯', '일곱', '여덟', '아홉'];
const gameCount = COUNT[games.length - 1] ?? String(games.length);
const pad2 = (n: number) => String(n).padStart(2, '0');
const aboutWords = ABOUT.split(/\s+/);
const introLabel = INTRO.words.map((w) => w.text).join('').trim();
const links = CONTACT.links.filter((l) => l.href);
// 지나온 시간: 연도별 묶음. 오도미터는 연도(4자리)만 굴린다
const years = [...new Set(TIMELINE.map((e) => e.date.slice(0, 4)))];
const firstYear = TIMELINE[0]?.date.slice(0, 4) ?? '';
const kindsOf = (e: (typeof TIMELINE)[number]) => [...new Set((e.links ?? []).map((l) => l.kind))];
const pending = CONTACT.links.filter((l) => !l.href);
---

<Layout home>
  <canvas id="light" aria-hidden="true"></canvas>
  <div class="veil" id="veil" aria-hidden="true"></div>
  <div class="veil-g" id="veilG" aria-hidden="true"></div>
  <div class="glow-fallback" id="glowFallback" aria-hidden="true"></div>
  <div class="iris" id="iris" aria-hidden="true"></div>

  <main class="stage" id="top">
    <section class="intro" id="intro" aria-label="첫 화면">
      <div class="intro__stage">
        <h1 class="line" id="line" aria-label={introLabel}>
          {INTRO.words.map((w) => <span class:list={['w', { 'hot-target': 'hot' in w && w.hot }]} aria-hidden="true">{w.text}</span>)}
        </h1>
        <div class="intro__foot">
          <p class="sub" id="sub" set:html={INTRO.sub} />
          <span class="hint" id="hint" aria-hidden="true"><i></i>아래로</span>
        </div>
      </div>
    </section>

    <section class="about pad" id="about" aria-label="소개">
      <span class="cap">소개</span>
      <p class="big words" id="aboutText">
        {aboutWords.map((w, i) => <Fragment><span class="w">{w}</span>{i < aboutWords.length - 1 ? ' ' : ''}</Fragment>)}
      </p>
    </section>

    <section id="works" aria-label="작품">
      <div class="works-intro pad">
        <span class="cap">작품 · {gameCount} 개의 장면</span>
        <h2>직접 만든<br />{gameCount} 개의 게임.</h2>
      </div>
      {
        games.map((g, i) => {
          const d = g.data;
          const thumb = d.images[0]?.src ?? '';
          const href = `/games/${d.slug}`;
          return (
            <article class="scene" data-light={d.light}>
              <div class="scene__in pad">
                <div class="scene__txt">
                  <span class="scene__no">{ORDINAL[i]} 번째 장면 · {pad2(i + 1)} / {pad2(games.length)}</span>
                  <h3>{d.title}</h3>
                  {d.line && <p class="scene__line">{d.line}</p>}
                  <span class="scene__meta">
                    {d.period && <span>{d.period}{d.event && ` · ${d.event}`}</span>}
                    {d.role && <span>{d.role}</span>}
                  </span>
                  <a class="scene__go" href={href}>{d.playUrl ? '들어가서 플레이하기' : '들어가서 보기'} <span aria-hidden="true">→</span></a>
                </div>
                <figure class="scene__pic" data-href={href}>
                  {thumb && <img src={thumb} alt={`${d.title} 스크린샷`} loading={i === 0 ? 'eager' : 'lazy'} />}
                  {
                    d.video && (
                      <Fragment>
                        <video muted loop playsinline preload="none" data-src={d.video} aria-hidden="true" />
                        <span class="rec">플레이 영상</span>
                      </Fragment>
                    )
                  }
                </figure>
              </div>
            </article>
          );
        })
      }
    </section>

    <section class="notes pad" id="notes" aria-label="작업 노트">
      <div class="sec-h">
        <span class="cap">작업 노트 · NC AI</span>
        <h2>캐릭터 뒤에서 움직이는 것들.</h2>
        <p>NC AI에서 만든 것 중 {work.length}가지를 골랐습니다. 줄 위에 커서를 올리면 장면이 비칩니다.</p>
      </div>
      <div class="rows">
        {
          work.map((w) => (
            <a class="row" href={`/work/${w.data.slug}`} data-art={w.data.images[0] ? `url('${w.data.images[0]}') center / cover` : w.data.art}>
              <span class="row__per">{w.data.period}</span>
              <span class="row__t">{w.data.title}</span>
              <span class="row__d">{w.data.description}</span>
              <span class="row__go" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="time pad" id="time" aria-label="지나온 시간">
      <div class="sec-h"><span class="cap">지나온 시간 · {years[0]} – {years[years.length - 1]}</span><h2>여기까지 걸어온 길.</h2></div>
      <div class="time__grid">
        <div class="time__stick" aria-hidden="true">
          <div class="odo" id="odo">
            {
              Array.from(firstYear).map((ch) => (
                <span class="odo__col">
                  <span style={`transform: translateY(-${ch}em)`}>
                    {Array.from({ length: 10 }, (_, n) => <span>{n}</span>)}
                  </span>
                </span>
              ))
            }
          </div>
          <p class="odo-label" id="odoLabel"><span class="cap">{TIMELINE[0]?.date}</span><b>{TIMELINE[0]?.title}</b></p>
        </div>
        <div class="tl">
          {
            years.map((y) => (
              <section class="yr" data-year={y} aria-label={`${y}년`}>
                <h3 class="yr__y">{y}</h3>
                <ol>
                  {TIMELINE.filter((e) => e.date.startsWith(y)).map((e) => (
                    <li class:list={['ev', { pick: e.links?.length }]} data-date={e.date} data-end={e.end ?? ''}>
                      <span class="ev__m">{e.date.slice(5)}</span>
                      <span>
                        <span class="ev__t">{e.title}</span>
                        {e.end && <span class="ev__end">– {e.end}</span>}
                        {e.links?.length ? (
                          <span class="ev__links">
                            {kindsOf(e).map((k) => (
                              <Fragment>
                                <span class="ev__k">{k}</span>
                                {(e.links ?? []).filter((l) => l.kind === k).map((l, j) => (
                                  <Fragment>
                                    {j > 0 && <i aria-hidden="true">·</i>}
                                    <a href={l.href}>{l.label}</a>
                                  </Fragment>
                                ))}
                              </Fragment>
                            ))}
                          </span>
                        ) : null}
                      </span>
                    </li>
                  ))}
                </ol>
              </section>
            ))
          }
        </div>
      </div>
    </section>

    <section class="tools pad" id="tools" aria-label="다루는 것">
      <div class="sec-h"><span class="cap">다루는 것</span></div>
      <dl class="tool-rows">
        {
          TOOLS.map((t) => (
            <div class="tool-row">
              <dt>{t.label}</dt>
              <dd class="words">{t.items.map((it) => <span class="w">{it}</span>)}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="contact pad" id="contact" aria-label="연락">
      <span class="cap">연락</span>
      <h2>{CONTACT.heading}</h2>
      {
        CONTACT.email && (
          <div class="mail">
            <a href={`mailto:${CONTACT.email}`} id="mailText">{CONTACT.email}</a>
            <button type="button" id="copyBtn">주소 복사</button>
          </div>
        )
      }
      <div class="others">
        {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
        {pending.map((l) => <span>{l.label} · 준비 중</span>)}
      </div>
    </section>
    <footer class="foot pad cap">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <span>빛 효과 · WebGL Fluid Simulation (Pavel Dobryakov, MIT) 수정본</span>
    </footer>
  </main>

  <div class="peek" id="peek" aria-hidden="true"><i></i></div>
  <button type="button" class="skip" id="skip">인트로 건너뛰기</button>

  <script>
    import { boot } from '../scripts/home';
    boot();
  </script>
</Layout>
