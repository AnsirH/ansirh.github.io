---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE, LINKS } from '../consts';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

const games = (await getCollection('games')).sort(byOrder);
const work = (await getCollection('work')).sort(byOrder);
---

<Layout>
  <!-- 히어로 -->
  <section class="border-b border-slate-200 pb-12">
    <p class="text-sm font-medium uppercase tracking-wide text-slate-400">{SITE.role}</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{SITE.name}</h1>
    <p class="mt-4 max-w-2xl text-slate-600">{SITE.tagline}</p>
    <ul class="mt-6 flex flex-wrap gap-4 text-sm">
      {
        LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded border border-slate-200 px-3 py-1.5 hover:border-slate-400"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 게임 -->
  <section id="games" class="scroll-mt-20 py-12">
    <h2 class="text-xl font-semibold tracking-tight">게임</h2>
    <p class="mt-1 text-sm text-slate-500">플레이 가능한 Unity WebGL 빌드</p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {games.map((game) => <GameCard game={game} />)}
    </div>
  </section>

  <!-- 작업 -->
  <section id="work" class="scroll-mt-20 border-t border-slate-200 py-12">
    <h2 class="text-xl font-semibold tracking-tight">작업</h2>
    <p class="mt-1 text-sm text-slate-500">최근 9개월간의 주요 작업</p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {work.map((item) => <WorkCard work={item} />)}
    </div>
  </section>
</Layout>
