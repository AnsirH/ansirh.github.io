---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SpecPanel from '../components/SpecPanel.astro';
import ThumbnailReel from '../components/ThumbnailReel.astro';
import type { ReelItem } from '../components/ThumbnailReel.astro';
import GameCard from '../components/GameCard.astro';
import WorkCard from '../components/WorkCard.astro';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

const games = (await getCollection('games')).sort(byOrder);
const work = (await getCollection('work')).sort(byOrder);

const reelItems: ReelItem[] = [
  ...games.map((game) => ({ kind: 'GAME', title: game.data.title })),
  ...work.map((item) => ({ kind: 'WORK', title: item.data.title })),
];
---

<Layout>
  <Hero />
  <SpecPanel />
  <ThumbnailReel items={reelItems} />

  <section id="games" class="mx-auto max-w-5xl scroll-mt-24 px-6 py-24">
    <h2 class="text-3xl font-black tracking-tight sm:text-4xl">게임</h2>
    <p class="mt-2 text-sm text-zinc-500">플레이 가능한 Unity WebGL 빌드</p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {games.map((game) => <GameCard game={game} />)}
    </div>
  </section>

  <section id="work" class="mx-auto max-w-5xl scroll-mt-24 border-t border-zinc-200 px-6 py-24">
    <h2 class="text-3xl font-black tracking-tight sm:text-4xl">작업</h2>
    <p class="mt-2 text-sm text-zinc-500">최근 9개월간의 주요 작업</p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {work.map((item) => <WorkCard work={item} />)}
    </div>
  </section>
</Layout>
