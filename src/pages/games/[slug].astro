---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import '../../styles/detail.css';

export async function getStaticPaths() {
  const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
  return games.map((game, i) => ({
    params: { slug: game.data.slug },
    props: { game, index: i, total: games.length, next: games[(i + 1) % games.length] },
  }));
}

const { game, index, total, next } = Astro.props;
const d = game.data;
const { Content } = await render(game);
const hasBody = (game.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;

const ORDINAL = ['첫', '두', '세', '네', '다섯', '여섯', '일곱', '여덟', '아홉'];
const pad2 = (n: number) => String(n).padStart(2, '0');
const [c1, c2] = d.colors;

// 오락기 화면 = 첫 스크린샷, 장면들 = 나머지 스크린샷 (최대 3장)
const cover = d.images[0]?.src ?? '';
const stills = d.images.slice(d.images.length > 1 ? 1 : 0, 4).map((im, k) => ({ src: im.src, label: im.caption || `CAPTURE ${pad2(k + 1)}` }));
const extLinks = [...(d.repoUrl ? [{ label: 'GitHub', href: d.repoUrl }] : []), ...d.links];
const bugLabels = [
  ['문제', 'k-err'],
  ['원인', 'k-cause'],
  ['해결', 'k-fix'],
  ['배운 점', 'k-note'],
] as const;
---

<Layout title={d.title} description={d.description}>
  <main class="stage">
    <div class="gd pad" style={`--g1:${c1};--g2:${c2}`} data-play={d.playUrl} data-note={d.playNote}>
      <div class="gd__top">
        <a class="back" href="/#works">← 작품으로</a>
        <span class="cap">{ORDINAL[index]} 번째 장면 · {pad2(index + 1)} / {pad2(total)}</span>
      </div>

      <div class="cab">
        <div class="screen" id="screen">
          {cover && <img class="screen__shot" src={cover} alt="" aria-hidden="true" />}
          <button type="button" class="screen__ui" id="gdStart" aria-label={`${d.title} 시작`}>
            <span class="inner" id="gdInner">
              <span class="screen__logo">{d.title.toUpperCase()}</span>
              <span class="blink">PRESS START</span>
            </span>
          </button>
        </div>
        {
          d.controls.length > 0 && (
            <div class="keys">
              {d.controls.map((c) => (
                <span>
                  {c.slice(0, -1).map((k) => <span class="key" data-key={k}>{k}</span>)} {c[c.length - 1]}
                </span>
              ))}
            </div>
          )
        }
      </div>

      <header class="gd__title">
        <h1 id="gdTitle">{d.title}</h1>
        <p>{d.description}</p>
        <dl class="gd__meta">
          <div><dt>ROLE</dt><dd>{d.role || '—'}</dd></div>
          <div><dt>TECH</dt><dd>{d.techStack.join(' · ') || '—'}</dd></div>
          <div><dt>TIME</dt><dd>{d.period || '—'}{d.event && <Fragment><br /><span class="gd__event">{d.event}</span></Fragment>}</dd></div>
          <div>
            <dt>LINKS</dt>
            <dd class="gd__links">
              {extLinks.length ? extLinks.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>) : <span style="color:var(--text-3)">준비 중</span>}
            </dd>
          </div>
        </dl>
      </header>

      {
        d.highlights.length > 0 && (
          <section class="gsec">
            <div class="gsec__h"><h2>무엇을 만들었나</h2></div>
            <div class="three">
              {d.highlights.map((h) => (
                <div>
                  <b>{h.label}</b>
                  <p>{h.text}</p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        hasBody && (
          <section class="gsec">
            <div class="gsec__h"><h2>구현 노트</h2></div>
            <div class="gbody"><Content /></div>
          </section>
        )
      }

      {
        stills.length > 0 && (
          <section class="gsec">
            <div class="gsec__h">
              <h2>장면들</h2>
            </div>
            <div class="stills">
              {stills.map((s) => (
                <figure class="still">
                  <img src={s.src} alt="" loading="lazy" />
                  <figcaption>{s.label}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

      {
        d.troubleshooting.length > 0 && (
          <section class="gsec">
            <div class="gsec__h">
              <h2>버그 기록</h2>
              <span class="cap">{d.troubleshooting.length}건 · 모두 해결</span>
            </div>
            <div class="bugs">
              {d.troubleshooting.map((b, k) => {
                const rows = [b.problem, b.cause, b.solution, b.learned];
                return (
                  <article class="bug" data-bug>
                    <div class="bug__h">
                      <b>BUG {pad2(k + 1)}</b>
                      <span>해결</span>
                    </div>
                    {rows.map((t, j) =>
                      t ? (
                        <div class="bug__row">
                          <span class:list={['k', bugLabels[j][1]]}>{bugLabels[j][0]}</span>
                          <p data-text={t}>{t}</p>
                        </div>
                      ) : null,
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        )
      }

      <a class="next gd__next" href={`/games/${next.data.slug}`}>
        <span><span class="cap">다음 장면</span><br /><b>{next.data.title}</b></span>
        <span class="blink" aria-hidden="true">▶</span>
      </a>
    </div>
  </main>

  <script>
    import { bootGame } from '../../scripts/game';
    bootGame();
  </script>
</Layout>
