---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({
    params: { slug: game.data.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const { title, description, period, role, techStack, repoUrl, playUrl, images, troubleshooting } =
  game.data;
const { Content } = await render(game);

const meta = [period, role].filter(Boolean);
const heroImage = images[0] ?? '';
---

<Layout title={title} description={description}>
  <!-- 헤더 — 스크린샷을 배경으로 -->
  <header class="gh-hero" style={heroImage ? `--hero-bg: url('${heroImage}')` : undefined}>
    <div class="gh-hero__bg" aria-hidden="true"></div>
    <div class="gh-hero__scrim" aria-hidden="true"></div>

    <a href="/#games" class="gh-hero__back">← 게임 목록</a>

    <div class="gh-hero__inner">
      <h1 class="gh-hero__title">{title}</h1>
      <p class="gh-hero__desc">{description}</p>
      {meta.length > 0 && <p class="gh-hero__meta">{meta.join(' · ')}</p>}
      {
        techStack.length > 0 && (
          <ul class="gh-hero__stack">
            {techStack.map((tech) => (
              <li>{tech}</li>
            ))}
          </ul>
        )
      }
      {
        repoUrl && (
          <a href={repoUrl} target="_blank" rel="noopener" class="gh-hero__repo">
            GitHub ↗
          </a>
        )
      }
    </div>
  </header>

  <!-- 플레이 (웹 빌드) — 크게 -->
  <section id="play" class="gh-play">
    {
      playUrl ? (
        <div class="gh-play__frame">
          <iframe src={playUrl} title={`${title} WebGL 빌드`} allow="fullscreen" />
        </div>
      ) : (
        <div class="gh-play__frame gh-play__frame--empty">빌드 준비 중</div>
      )
    }
  </section>

  <!-- 본문 -->
  <div class="mx-auto max-w-3xl px-6 pb-16">
    <section class="border-b border-zinc-200 py-10">
      <h2 class="text-lg font-bold">개요 &amp; 구현</h2>
      <div class="mt-4 space-y-3 text-zinc-600">
        <Content />
      </div>
    </section>

    {
      troubleshooting.length > 0 && (
        <section class="py-10">
          <h2 class="text-lg font-bold">트러블슈팅</h2>
          <ol class="mt-6 space-y-6">
            {troubleshooting.map((entry, i) => (
              <li class="rounded-lg border border-zinc-200 p-5">
                <p class="flex gap-2 font-bold">
                  <span class="text-zinc-400">{String(i + 1).padStart(2, '0')}</span>
                  <span>{entry.problem}</span>
                </p>
                <dl class="mt-3 space-y-2 text-sm">
                  {entry.cause && (
                    <div class="flex gap-3">
                      <dt class="w-16 shrink-0 font-medium text-zinc-400">원인</dt>
                      <dd class="text-zinc-600">{entry.cause}</dd>
                    </div>
                  )}
                  <div class="flex gap-3">
                    <dt class="w-16 shrink-0 font-medium text-zinc-400">해결</dt>
                    <dd class="text-zinc-700">{entry.solution}</dd>
                  </div>
                  {entry.learned && (
                    <div class="flex gap-3">
                      <dt class="w-16 shrink-0 font-medium text-zinc-400">배운 점</dt>
                      <dd class="text-zinc-600">{entry.learned}</dd>
                    </div>
                  )}
                </dl>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <nav class="border-t border-zinc-200 pt-8 text-sm">
      <a href="/#games" class="text-zinc-500 hover:text-zinc-900">← 게임 목록</a>
    </nav>
  </div>
</Layout>

<style>
  .gh-hero {
    position: relative;
    min-height: 60svh;
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
    color: #fafafa;
  }

  .gh-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      var(--hero-bg, none) center / cover no-repeat,
      radial-gradient(120% 90% at 50% 0%, #14141c 0%, #0a0a0c 70%);
    background-color: #0a0a0c;
  }

  .gh-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(8, 8, 12, 0.3) 0%,
      rgba(8, 8, 12, 0.32) 40%,
      rgba(8, 8, 12, 0.85) 100%
    );
  }

  .gh-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 64rem;
    margin-inline: auto;
    padding: 6rem 1.5rem 2.75rem;
  }

  .gh-hero__back {
    position: absolute;
    z-index: 2;
    top: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 64rem;
    padding-inline: 1.5rem;
    font-size: 0.875rem;
    color: rgba(250, 250, 250, 0.8);
  }
  .gh-hero__back:hover {
    color: #fff;
  }

  .gh-hero__title {
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    font-size: clamp(2.25rem, 7vw, 4rem);
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.55);
  }

  .gh-hero__desc {
    margin-top: 0.9rem;
    font-size: 1.05rem;
    color: rgba(250, 250, 250, 0.85);
  }

  .gh-hero__meta {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    color: rgba(250, 250, 250, 0.6);
  }

  .gh-hero__stack {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .gh-hero__stack li {
    border: 1px solid rgba(250, 250, 250, 0.25);
    border-radius: 0.25rem;
    padding: 0.125rem 0.5rem;
    font-size: 0.7rem;
    color: rgba(250, 250, 250, 0.8);
  }

  .gh-hero__repo {
    display: inline-block;
    margin-top: 1.25rem;
    border: 1px solid rgba(250, 250, 250, 0.35);
    border-radius: 0.375rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .gh-hero__repo:hover {
    border-color: #fff;
  }

  /* 플레이 — 화면을 크게 */
  .gh-play {
    background: #09090b;
    padding: 1.5rem;
  }
  .gh-play__frame {
    width: min(90rem, 100%);
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    max-height: 78svh;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .gh-play__frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .gh-play__frame--empty {
    display: grid;
    place-items: center;
    background: #111114;
    border-style: dashed;
    border-color: #27272a;
    color: #52525b;
    font-size: 0.875rem;
  }
</style>
