---
import '../styles/global.css';
import { SITE, ANALYTICS } from '../consts';

interface Props {
  /** <title> 에 들어갈 페이지 제목. 생략하면 사이트 이름만 표시 */
  title?: string;
  /** <meta name="description"> — 생략하면 사이트 기본 설명 */
  description?: string;
  /** 메인 페이지: 인트로가 끝날 때까지 머리글을 숨기고, 내비는 같은 페이지 앵커로 */
  home?: boolean;
}

const { title, description = SITE.description, home = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.role}`;
const base = home ? '' : '/';
const nav = [
  { id: 'works', label: '작품' },
  { id: 'career', label: '경력' },
  { id: 'time', label: '타임라인' },
  { id: 'contact', label: '연락' },
];

// 방문자 통계: 프로덕션 빌드에서 code 가 설정돼 있을 때만 로드
const goatCounterUrl =
  import.meta.env.PROD && ANALYTICS.goatCounterCode
    ? `https://${ANALYTICS.goatCounterCode}.goatcounter.com/count`
    : null;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070706" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@300;400;500&family=Noto+Sans+KR:wght@400;500&family=IBM+Plex+Mono:wght@400&family=Silkscreen:wght@400;700&display=swap"
    />
    {
      goatCounterUrl && (
        <script is:inline data-goatcounter={goatCounterUrl} async src="//gc.zgo.at/count.js" />
      )
    }
  </head>
  <body>
    <div class="app">
      <header class:list={['head', { pre: home }]} id="head">
        <a class="name" href={home ? '#top' : '/'}>{SITE.name}</a>
        <nav aria-label="섹션" id="nav">
          {nav.map((n) => <a href={`${base}#${n.id}`} data-sec={n.id}>{n.label}</a>)}
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
