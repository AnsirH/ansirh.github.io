---
import '../styles/global.css';
import { SITE, ANALYTICS } from '../consts';

interface Props {
  /** <title> 에 들어갈 페이지 제목. 생략하면 사이트 이름만 표시 */
  title?: string;
  /** <meta name="description"> — 생략하면 사이트 기본 설명 */
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.role}`;

// 방문자 통계: 프로덕션 빌드에서 code 가 설정돼 있을 때만 로드
const goatCounterUrl =
  import.meta.env.PROD && ANALYTICS.goatCounterCode
    ? `https://${ANALYTICS.goatCounterCode}.goatcounter.com/count`
    : null;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <!-- JS 사용 가능 표시 — reveal 요소는 이 클래스가 있을 때만 숨겨진다 -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {
      goatCounterUrl && (
        <script
          is:inline
          data-goatcounter={goatCounterUrl}
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col bg-white text-zinc-950 antialiased">
    <header class="sticky top-0 z-20 border-b border-zinc-200 bg-white/80 backdrop-blur">
      <nav
        class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4"
        aria-label="주요 내비게이션"
      >
        <a href="/" class="font-black tracking-tight hover:text-zinc-500">{SITE.name}</a>
        <ul class="flex gap-6 text-sm">
          <li><a href="/#games" class="hover:text-zinc-500">게임</a></li>
          <li><a href="/#work" class="hover:text-zinc-500">작업</a></li>
        </ul>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-zinc-200">
      <div class="mx-auto max-w-5xl px-6 py-6 text-sm text-zinc-500">
        © {new Date().getFullYear()} {SITE.name}. Built with Astro.
      </div>
    </footer>

    <script>
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>
