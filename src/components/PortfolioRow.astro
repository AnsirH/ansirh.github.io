---
/** 게임/작업 카드 한 건 — PortfolioRow(목록형)·PortfolioGallery(풀스크린) 공통 데이터 모양 */
export interface PortfolioItem {
  /** 상세 페이지 경로 */
  href: string;
  /** 분류 라벨 (예: "GAME", "WORK") */
  kind: string;
  title: string;
  description: string;
  /** 썸네일 이미지 경로. 없으면 placeholder */
  image?: string;
  /** 칩으로 보여줄 태그 (기술 스택 / 기간 등) */
  tags?: readonly string[];
}

type Props = PortfolioItem;

const { href, kind, title, description, image, tags = [] } = Astro.props;
---

<a
  href={href}
  data-reveal
  class="group grid gap-6 rounded-lg border border-zinc-200 p-5 transition-colors hover:border-zinc-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900 sm:grid-cols-2 sm:items-center sm:gap-8"
>
  <div class="overflow-hidden rounded-md bg-zinc-100">
    {
      image ? (
        <img
          src={image}
          alt=""
          loading="lazy"
          class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <div
          class="flex aspect-video items-center justify-center text-xs text-zinc-400"
          aria-hidden="true"
        >
          이미지 준비 중
        </div>
      )
    }
  </div>

  <div>
    <p class="text-xs font-medium uppercase tracking-wide text-zinc-400">{kind}</p>
    <h3 class="mt-1 text-xl font-bold group-hover:text-zinc-500">{title}</h3>
    <p class="mt-2 text-sm text-zinc-600">{description}</p>
    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li class="rounded bg-zinc-100 px-2 py-0.5 text-xs text-zinc-500">{tag}</li>
          ))}
        </ul>
      )
    }
    <span class="mt-4 inline-block text-sm font-medium text-zinc-900 group-hover:underline">
      자세히 보기 →
    </span>
  </div>
</a>
