---
import { SPEC } from '../consts';
---

<section class="spec" aria-label="스펙">
  <div class="spec__inner">
    {
      SPEC.map((group, i) => (
        <div class="spec__group" data-reveal style={`--reveal-i:${i}`}>
          <h2 class="spec__label">{group.label}</h2>
          <ul class="spec__items">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .spec {
    padding-block: 16svh;
  }

  .spec__inner {
    display: grid;
    gap: 5rem;
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .spec__group {
    display: grid;
    gap: 0.9rem;
  }

  .spec__label {
    font-weight: 800;
    font-size: clamp(1.75rem, 6vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .spec__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }

  .spec__items li {
    font-weight: 300;
    font-size: clamp(1rem, 3vw, 1.6rem);
    color: #3f3f46;
  }
</style>
