---
import type { PortfolioItem } from './PortfolioRow.astro';

/** 갤러리 맨 앞에 슬라이드 0으로 합쳐 넣는 섹션 구분 헤더 콘텐츠 */
export interface GalleryDivider {
  label: string;
  sublabel?: string;
  index?: string;
  tag?: string;
  /** 화면 가장자리에 도킹되는 이미지 조각(좌/우) — 없으면 생략 */
  leftImage?: string;
  rightImage?: string;
}

interface Props {
  items: readonly PortfolioItem[];
  /**
   * 갤러리 앞에 붙는 섹션 구분 슬라이드. 넘기면 별도 장면이 아니라 이
   * 갤러리의 슬라이드 0번으로 렌더링되어, 하나의 이어진 `.pg__sticky` 안에서
   * 화면 위치 변화 없이 첫 아이템으로 크로스페이드된다 — 자세한 이유는
   * src/scripts/portfolio-gallery.ts 상단 주석 참고.
   */
  divider?: GalleryDivider;
}

const { items, divider } = Astro.props;
const slideCount = items.length + (divider ? 1 : 0);
---

{
  slideCount > 0 && (
    <div class="pg" style={`--pg-count:${slideCount}`}>
      <div class="pg__sticky">
        {divider && (
          <div class="pg__panel pg__panel--divider" data-index="0" aria-hidden="true">
            <div
              class="sd__slide-left pgd__peek pgd__peek--l"
              style={divider.leftImage ? `background-image:url('${divider.leftImage}')` : undefined}
            />
            <div
              class="sd__slide-right pgd__peek pgd__peek--r"
              style={divider.rightImage ? `background-image:url('${divider.rightImage}')` : undefined}
            />

            <div class="pgd__row">
              <div class="sd__slide-left pgd__chrome pgd__chrome--l">
                {divider.index && <span class="pgd__idx">{divider.index}</span>}
                <span class="pgd__rule" />
              </div>

              <div class="sd__reveal pgd__title">
                <h2>{divider.label}</h2>
                {divider.sublabel && <p>{divider.sublabel}</p>}
              </div>

              <div class="sd__slide-right pgd__chrome pgd__chrome--r">
                <span class="pgd__rule" />
                {divider.tag && <span class="pgd__tag">{divider.tag}</span>}
              </div>
            </div>
          </div>
        )}

        {items.map((item, i) => {
          const index = divider ? i + 1 : i;
          return (
            <a
              href={item.href}
              class="pg__panel"
              data-index={index}
              aria-hidden={index === 0 ? 'false' : 'true'}
              tabindex={index === 0 ? 0 : -1}
            >
              <div class="pg__media">
                {item.image ? (
                  <div class="pg__bg" style={`background-image:url('${item.image}')`} />
                ) : (
                  <div class="pg__bg pg__bg--empty" aria-hidden="true">
                    이미지 준비 중
                  </div>
                )}
                <div class="pg__scrim" />
              </div>

              <div class="pg__text">
                <p class="pg__kind">{item.kind}</p>
                <h3 class="pg__title">{item.title}</h3>
                <p class="pg__desc">{item.description}</p>
                {item.tags && item.tags.length > 0 && (
                  <ul class="pg__tags">
                    {item.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                )}
                <span class="pg__link">자세히 보기 →</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  )
}

<style>
  /*
   * 풀스크린 "홀드 → 검은 화면 → 페이드인" 갤러리.
   * 컨테이너 높이 = 슬라이드 수 * 100svh 로 스크롤 거리를 만들고,
   * 그 안에서 .pg__sticky 가 화면에 고정된 채(화면은 안 움직임)
   * src/scripts/portfolio-gallery.ts 가 스크롤량에 정확히 비례해
   * .pg__media(이미지+스크림) 의 opacity 를 직접 계산해 적용한다
   * (시간 기반 애니메이션 아님 → 스크롤을 멈추면 전환도 그 자리에서 멈춘다).
   *
   * .pg__text 는 이미지와 달리 스크롤량에 그대로 붙지 않고, 같은 스크립트가
   * "지금 이 패널이 충분히 보이는가"만 판단해 .is-visible 클래스를 켜고 끈다 —
   * 실제 나타나고 사라지는 움직임은 아래 transition(이징 + 위/아래 이동)이
   * 맡아서, 스펙 섹션(예: 툴)의 리빌과 같은 "자연스러운" 등장/퇴장이 된다.
   *
   * prefers-reduced-motion / JS 미실행 시 .pg 자체를 숨김 — 옆의 일반
   * 목록(.pg-fallback, index.astro)이 대신 보인다. global.css 참고.
   */
  .pg {
    position: relative;
    height: calc(var(--pg-count, 1) * 100svh);
    /* .pg__sticky 는 항상 뷰포트 높이(100svh)만큼만 그려지는데, svh 값이
     * 매 프레임 완전히 같은 픽셀로 반올림되지 않으면 스크롤 중 아주 잠깐
     * .pg 자기 배경(투명 → 본문 배경색)이 한 줄 비쳐 보일 수 있다. 갤러리
     * 섹션끼리 이어지는 경계에서 흰 줄로 보이던 문제라, .pg 자체도 같은
     * 어두운 배경을 깔아 그 틈이 항상 어둡게 채워지도록 한다. */
    background: #0a0a0c;
  }

  .pg__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    /* 이미지 사이 전환 중 미디어가 전부 투명해지는 구간에 보이는 검은 화면 */
    background: #0a0a0c;
  }

  .pg__panel {
    position: absolute;
    inset: 0;
    display: block;
    color: #fff;
  }

  /* 이미지 + 스크림 — 스크롤량에 정확히 비례하는 opacity (스크립트가 직접 대입) */
  .pg__media {
    position: absolute;
    inset: 0;
    opacity: 0;
    will-change: opacity;
  }
  .pg__panel[data-index="0"] .pg__media {
    opacity: 1;
  }

  .pg__bg {
    position: absolute;
    inset: 0;
    background: center / cover no-repeat;
    background-color: #0a0a0c;
  }
  .pg__bg--empty {
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, #1c1c22 0%, #0a0a0c 100%);
    color: #52525b;
    font-size: 0.85rem;
  }

  .pg__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(6, 6, 8, 0.82) 0%,
      rgba(6, 6, 8, 0.45) 40%,
      rgba(6, 6, 8, 0) 68%
    );
  }

  /* 텍스트 — 자연스러운 등장/퇴장 (스펙 섹션 리빌과 동일한 이징) */
  .pg__text {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 0;
    max-width: 28rem;
    padding: 0 3rem;
    opacity: 0;
    transform: translateY(calc(-50% + 1.5rem));
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pg__text.is-visible {
    opacity: 1;
    transform: translateY(-50%);
  }

  .pg__kind {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .pg__title {
    margin-top: 0.6rem;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .pg__desc {
    margin-top: 0.9rem;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .pg__tags {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .pg__tags li {
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 0.25rem;
    padding: 0.125rem 0.5rem;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .pg__link {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .pg__panel:hover .pg__link {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .pg__scrim {
      background: linear-gradient(
        0deg,
        rgba(6, 6, 8, 0.85) 0%,
        rgba(6, 6, 8, 0.35) 45%,
        rgba(6, 6, 8, 0) 72%
      );
    }
    .pg__text {
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      max-width: none;
      padding: 2rem 1.5rem 2.5rem;
      transform: translateY(1.5rem);
    }
    .pg__text.is-visible {
      transform: translateY(0);
    }
  }

  /* ============================================================
   * 디바이더 슬라이드(.pg__panel--divider) — 1+3안(HUD+Peek)과 동일한 구성.
   * opacity 는 이 패널 전체(.pg__panel--divider)에 스크립트가 직접 대입한다
   * (다른 패널처럼 .pg__media 를 따로 두지 않음 — 이미지 조각+크롬 전체가
   * 하나로 크로스페이드된다).
   * ============================================================ */
  .pg__panel--divider {
    display: grid;
    place-items: center;
    background: #0a0a0c;
    color: #fafafa;
  }

  .pgd__peek {
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 0;
    width: min(34vw, 26rem);
    background: center / cover no-repeat;
    background-color: #1c1c22;
    will-change: transform;
  }
  .pgd__peek--r {
    inset: 0 0 0 auto;
  }
  .pgd__peek--l::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10, 10, 12, 0) 45%, rgba(10, 10, 12, 0.98) 100%);
  }
  .pgd__peek--r::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(270deg, rgba(10, 10, 12, 0) 45%, rgba(10, 10, 12, 0.98) 100%);
  }

  .pgd__row {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    max-width: 90rem;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .pgd__chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    white-space: nowrap;
    will-change: transform;
  }
  .pgd__chrome--l {
    justify-content: flex-end;
  }
  .pgd__chrome--r {
    justify-content: flex-start;
  }

  .pgd__rule {
    display: inline-block;
    width: clamp(2.5rem, 8vw, 6rem);
    height: 1px;
    background: rgba(255, 255, 255, 0.35);
  }

  .pgd__title h2 {
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    text-align: center;
    white-space: nowrap;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.6);
  }
  .pgd__title p {
    margin-top: 0.6rem;
    text-align: center;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 640px) {
    .pgd__peek {
      width: 20vw;
    }
    .pgd__row {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.75rem;
    }
    .pgd__chrome--l,
    .pgd__chrome--r {
      justify-content: center;
    }
  }
</style>
