---
import type { CollectionEntry } from 'astro:content';

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
const { title, description, slug, techStack } = game.data;
---

<a
  href={`/games/${slug}`}
  class="group flex flex-col rounded-lg border border-slate-200 p-5 transition-colors hover:border-slate-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-600"
>
  <!-- 썸네일 자리 — 실제 이미지는 다음 작업에서 -->
  <div
    class="mb-4 flex aspect-video items-center justify-center rounded-md bg-slate-100 text-xs text-slate-400"
    aria-hidden="true"
  >
    이미지 준비 중
  </div>
  <h3 class="font-semibold group-hover:text-slate-600">{title}</h3>
  <p class="mt-1 text-sm text-slate-600">{description}</p>
  {
    techStack.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {techStack.map((tech) => (
          <li class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-500">{tech}</li>
        ))}
      </ul>
    )
  }
</a>
