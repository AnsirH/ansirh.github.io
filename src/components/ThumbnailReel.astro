---
export interface ReelItem {
  /** 분류 라벨 (예: 'GAME', 'WORK') */
  kind: string;
  /** 표시 제목 */
  title: string;
}

interface Props {
  items: readonly ReelItem[];
}

const { items } = Astro.props;
---

<section class="reel" aria-label="포트폴리오 미리보기">
  <p class="reel__lead">포트폴리오</p>
  <div class="reel__track">
    {
      items.map((item) => (
        <figure class="reel__frame" data-sda="reveal">
          <div class="reel__thumb" aria-hidden="true">
            {item.title}
          </div>
          <figcaption class="reel__cap">
            {item.kind} · {item.title}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .reel {
    max-width: 60rem;
    margin-inline: auto;
    padding: 10svh 1.5rem;
  }

  .reel__lead {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #a1a1aa;
  }

  .reel__track {
    display: grid;
    gap: 12svh;
    margin-top: 3rem;
  }

  .reel__frame {
    margin: 0;
  }

  .reel__thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    padding: 1.5rem;
    text-align: center;
    background: #0a0a0a;
    color: #fff;
    border-radius: 0.9rem;
    font-weight: 800;
    font-size: clamp(1.25rem, 4.5vw, 2.75rem);
    letter-spacing: -0.03em;
  }

  .reel__cap {
    margin-top: 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #71717a;
  }
</style>
