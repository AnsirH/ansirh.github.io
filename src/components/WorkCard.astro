---
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'work'>;
}

const { work } = Astro.props;
const { title, period, description, slug } = work.data;
---

<a
  href={`/work/${slug}`}
  data-reveal
  class="group flex flex-col rounded-lg border border-zinc-200 p-5 transition-colors hover:border-zinc-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900"
>
  <p class="text-xs font-medium uppercase tracking-wide text-zinc-400">{period}</p>
  <h3 class="mt-1 font-bold group-hover:text-zinc-500">{title}</h3>
  <p class="mt-1 text-sm text-zinc-600">{description}</p>
</a>
